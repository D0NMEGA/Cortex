--swiftversion 6.2
--indent 2
--maxwidth 120
--linebreaks lf
--trimwhitespace always
--commas inline
--operatorfunc spaced
--ranges spaced
--semicolons never
--self remove
--patternlet hoist
--header strip
--exclude .build,Packages/.build,Packages/CortexCore/.build,Packages/CortexIPC/.build,Packages/CortexRender/.build,Packages/CortexDecoder/.build,DerivedData,Cortex.xcodeproj,Cortex.xcworkspace,vendor,fastlane/Fastfile,fastlane/Matchfile,fastlane/Appfile
