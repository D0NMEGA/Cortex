# fastlane/Appfile -- Phase 8 (DIST-02) real identity config.
# Replaces the Phase-1 placeholder (all fields were commented out under D-09 deferred-enrollment).
#
# SECRET DISCIPLINE: every identity field reads from ENV -- no real Apple ID / team id is
# committed. A clean clone has these unset, so the lanes fail loudly (see the Fastfile ENV guard)
# rather than half-running against the wrong account.
#
# WIRE-AND-GATE (CONTEXT D-01): these activate the moment Apple Developer Program enrollment lands
# and the ASC_* env vars are exported. Until then the values are nil and the live lanes are gated
# (Plan 07 HUMAN-UAT).

app_identifier "com.donovansantine.cortex.mac"      # the macOS bundle id (the iOS id is set per-lane / via match)
apple_id       ENV["ASC_APPLE_ID"]                  # from ENV -- never a literal email
team_id        ENV["ASC_TEAM_ID"]                   # Apple Developer Program team id, from ENV
itc_team_id    ENV["ASC_ITC_TEAM_ID"]               # App Store Connect (iTunes Connect) team id, from ENV
