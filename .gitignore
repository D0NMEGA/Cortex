# === Build artifacts ===
DerivedData/
.build/
build/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcshareddata/swiftpm/
.swiftpm/
Package.pins
Packages/*/.build/

# === XcodeGen output (regenerated; never committed) ===
Cortex.xcodeproj/
Cortex.xcworkspace/

# === Rust / CortexRing build artifacts (Phase 3) ===
# Built artifacts are regenerated by Tools/scripts/build-rust.sh (the `make bootstrap` analogue).
# The cbindgen-generated C header (Packages/CortexRing/rust/include/cortex_ring.h) IS committed and
# CI drift-gated (D-13); the xcframework and cargo target dir are rebuilt, never committed.
Packages/CortexRing/rust/target/
Packages/CortexRing/CortexRingFFI.xcframework/

# === Apple platform / Xcode noise ===
.DS_Store
*.swp
*.swo
*~

# === Code-signing material (NEVER commit; protects against accidental leak per Phase 1 threat model) ===
*.p8
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
fastlane/Matchfile.local
fastlane/.env
fastlane/report.xml

# === Coverage / profiling ===
*.profraw
*.profdata
*.gcda
*.gcno

# === Logs / dumps ===
*.log
*.crash
*.ips

# === Editor noise ===
.idea/
.vscode/
*.iml

# === Bundler / fastlane ===
.bundle/
vendor/bundle/
fastlane/.fastlane.tmp.bundle

# === Python (for any decoder training side-tooling) ===
__pycache__/
*.pyc
.venv/

# --- Phase 4: Decoder Python subsystem artifacts (code + manifests are tracked; these are not) ---
Decoder/.venv/
Decoder/data/
Decoder/**/*.mat
Decoder/checkpoints/
Decoder/**/*.pt
Decoder/**/*.ckpt
Decoder/**/*.mlpackage/
Decoder/**/__pycache__/
Decoder/.pytest_cache/
