*.log
*.crash
*.ips

# === Editor noise ===
.idea/
.vscode/
*.iml

# === Bundler / fastlane ===
.bundle/
vendor/bundle/
fastlane/.fastlane.tmp.bundle

# === Python (for any decoder training side-tooling) ===
__pycache__/
*.pyc
.venv/

# --- Phase 4: Decoder Python subsystem artifacts (code + manifests are tracked; these are not) ---
Decoder/.venv/
Decoder/data/
Decoder/**/*.mat
# D-20: the committed synthetic v7.3 CI fixture is the ONE tracked .mat (no dataset redistribution).
!Decoder/tests/fixtures/tiny_v73.mat
Decoder/checkpoints/
# --- Phase 10 (D-07): the real-session replay export. Gitignored like Decoder/data/ and
# materialized by the committed Decoder/scripts/export_replay.py from the SHA-256-pinned .mat.
# Raises no CC-BY redistribution question and keeps the Phase-9 D-21 tier split intact: CI never
# reads it. The ONE tracked export is the synthetic fixture below.
Decoder/exports/
!Decoder/tests/fixtures/tiny_replay.bin
!Decoder/tests/fixtures/tiny_replay.json
Decoder/**/*.pt
Decoder/**/*.ckpt
Decoder/**/*.mlpackage/
Decoder/**/__pycache__/
Decoder/.pytest_cache/
Decoder/.ruff_cache/

# Agent worktrees and session scratch. These are live git checkouts of OTHER branches; a
# `git add -A` stages them as gitlinks and publishes dangling submodule pointers. Matched by
# shape rather than by a tool-specific directory name, so it holds whichever harness is in use.
# The harness's own top-level directory is additionally ignored in .git/info/exclude, which is
# local and uncommitted.
.*/worktrees/

# Demo capture output. The .mov is large and nothing under here is committed.
# Committed figures live in docs/media/ instead -- see docs/media/radius-rule.gif, which is a
# rendered analysis figure produced by Decoder/scripts/radius_rule_figure.py, not a screen capture
# taken from this directory.
Tools/capture/out/
